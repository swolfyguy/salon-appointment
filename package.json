{
  "name": "salon-appointment",
  "version": "1.1.0",
  "private": true,
  "description": "Barbershop booking: static front end + Cloudflare Worker API + D1.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && npm run db:init:local && wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "db:init": "wrangler d1 execute salon-appointment --remote --file=worker/schema.sql",
    "db:init:local": "wrangler d1 execute salon-appointment --local --file=worker/schema.sql",
    "static": "npx --yes serve -l 5173 ."
  },
  "devDependencies": {
    "wrangler": "^4.131.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "zod": "^4.6.2"
  }
}
